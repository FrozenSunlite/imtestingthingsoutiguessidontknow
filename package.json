{
  "name": "terrific-talent-tree",
  "private": true,
  "version": "1.0.5",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "lint": "eslint . --quiet",
    "lint:fix": "eslint . --fix",
    "build:standalone": "node scripts/write-version.mjs && vite build --config vite.standalone.config.js",
    "apk:prepare": "node scripts/prepare-apk.mjs",
    "apk:build": "node scripts/build-apk.mjs",
    "apk:publish": "node scripts/publish-apk.mjs",
    "apk:gist": "node scripts/publish-apk-gist.mjs",
    "music:import": "node scripts/import-music.mjs",
    "sounds:import": "node scripts/import-sounds.mjs",
    "sounds:index": "node scripts/index-sounds.mjs",
    "test": "node --test tests/*.test.mjs",
    "preview": "vite preview",
    "srd:build": "node scripts/generate-srd-seed.mjs",
    "electron": "electron .",
    "electron:build": "npm run build:standalone && electron-builder --win && node scripts/publish-desktop.mjs",
    "desktop:publish": "node scripts/publish-desktop.mjs",
    "build:all": "npm run electron:build && npm run apk:prepare && npm run apk:build",
    "release:all": "npm run build:all && npm run apk:gist"
  },
  "dependencies": {
    "@capacitor-community/file-opener": "^8.0.1",
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/file-transfer": "^2.0.6",
    "@capacitor/filesystem": "^8.1.5",
    "@hello-pangea/dnd": "^18.0.1",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-progress": "^1.1.2",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-slider": "^1.2.3",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@tanstack/react-router": "^1.170.0",
    "@tanstack/react-start": "^1.168.60",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.475.0",
    "next-themes": "^0.4.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^9.0.1",
    "sonner": "^2.0.1",
    "tailwind-merge": "^3.0.2",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@eslint/js": "^9.19.0",
    "@vitejs/plugin-react": "^6.2.1",
    "autoprefixer": "^10.4.20",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "eslint": "^9.19.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.14.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "vite": "^8.3.5"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.frozensunlite.talenttree",
    "productName": "Talent Tree",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "standalone/Serve.ps1",
        "to": "server/Serve.ps1"
      },
      {
        "from": "standalone/desktop/app-dist/client",
        "to": "server/desktop/app-dist/client",
        "filter": [
          "**/*",
          "!downloads/**",
          "!TalentTree-Setup-*",
          "!*.blockmap",
          "!desktop-update.json"
        ]
      },
      {
        "from": "public/icons/icon-512.png",
        "to": "icon.png"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icons/icon-512.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Talent Tree"
    }
  },
  "description": "Terrific Talent Tree desktop app",
  "author": "FrozenSunlite",
  "overrides": {
    "brace-expansion@^1.1.7": "1.1.21"
  }
}
